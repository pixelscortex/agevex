{
  "jsPlugins": ["@convex-dev/eslint-plugin", "@stylistic/eslint-plugin"],
  "rules": {
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": "return"
      },
      {
        "blankLine": "always",
        "prev": ["const", "let"],
        "next": "*"
      },
      {
        "blankLine": "any",
        "prev": ["singleline-const", "singleline-let"],
        "next": ["singleline-const", "singleline-let"]
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["if", "for", "while", "try", "multiline-expression", "multiline-const"]
      },
      {
        "blankLine": "always",
        "prev": ["if", "for", "while", "try", "multiline-expression", "multiline-const"],
        "next": "*"
      }
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    ".vite-plus/**",
    "**/_generated/**",
    "docs/spec/**",
    ".repo/**",
    ".codegraph/**",
    ".agents/**",
    ".claude/**",
    "docs/site/.source/**",
    "docs/site/.output/**",
    "docs/site/.nitro/**",
    "docs/site/.tanstack/**",
    "docs/site/src/routeTree.gen.ts",
    "docs/site/public/r/**"
  ],
  "overrides": [
    {
      "files": ["**/component/**/*.ts", "tests/host.ts", "tests/fixture/**/*.ts"],
      "rules": {
        "@convex-dev/import-wrong-runtime": "off",
        "@convex-dev/no-old-registered-function-syntax": "error",
        "@convex-dev/require-args-validator": "error",
        "@convex-dev/require-access-control": "off",
        "@convex-dev/explicit-table-ids": "error",
        "@convex-dev/no-filter-in-query": "error",
        "@convex-dev/no-top-of-hour-crons": "warn",
        "@convex-dev/no-schema-import-cycle": "error",
        "@convex-dev/no-duplicate-indexes": "error",
        "@convex-dev/no-process-env": "error",
        "@convex-dev/no-collect-in-query": "error"
      }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "typescript/unbound-method": "off",
        "typescript/require-array-sort-compare": "off"
      }
    }
  ],
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  }
}

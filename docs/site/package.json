{
  "name": "sdk-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp build",
    "start": "vp preview --host 127.0.0.1 --port 3000",
    "typecheck": "bun run scripts/typecheck.ts",
    "fmt": "bun run --cwd ../.. fmt",
    "fmt:check": "bun run --cwd ../.. fmt:check",
    "lint": "bun run --cwd ../.. lint",
    "check": "bun run fmt:check && bun run lint && bun run typecheck",
    "api:build": "bun run scripts/generate-api-reference.ts",
    "check:snippets": "bun run --cwd ../.. build && bun run scripts/check-snippets.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "ai": "^7.0.143",
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "^1.167.46",
    "@types/bun": "latest",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "3.0.260903-beta",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  }
}

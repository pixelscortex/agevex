{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2021", "dom", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "agevex": ["./src/client/index.ts"],
      "agevex/tools": ["./src/modules/tools/client/index.ts"]
    }
  },
  "include": ["./src/**/*"]
}

{
  "name": "agevex",
  "version": "0.0.0",
  "private": true,
  "description": "A Workflow-backed Convex component and host client for managed agents.",
  "keywords": [
    "agent",
    "component",
    "convex",
    "delegation"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixelscortex/agevex.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/client/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./test": "./src/test.ts",
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "default": "./dist/sandbox/index.js"
    },
    "./sandbox/convex.config": {
      "types": "./dist/sandbox/component/convex.config.d.ts",
      "default": "./dist/sandbox/component/convex.config.js"
    },
    "./sandbox/test": "./src/sandbox/test.ts",
    "./sandbox/_generated/component.js": {
      "types": "./dist/sandbox/component/_generated/component.d.ts"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:tests": "tsc --noEmit --project tests/tsconfig.json",
    "codegen": "convex codegen --component-dir ./src/component",
    "fmt": "vp fmt . --ignore-path .prettierignore",
    "fmt:check": "vp fmt . --check --ignore-path .prettierignore",
    "lint": "vp lint . --deny-warnings",
    "lint:convex:check": "bun run scripts/check-convex-lint.ts",
    "check": "vp check . && bun run lint:convex:check",
    "test": "vp test --run",
    "test:live": "vp test --run --config vite.live.config.ts && vp test --run --config tests/sandbox/vite.live.config.ts && bun run test:live:telemetry",
    "test:live:telemetry": "vp test --run --config tests/telemetry/vite.live.config.ts --reporter verbose"
  },
  "dependencies": {
    "@convex-dev/workflow": "0.4.10",
    "@convex-dev/workpool": "0.4.14",
    "@daytona/convex": "2.1.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.102",
    "@ai-sdk/provider": "4.0.34",
    "@ai-sdk/provider-utils": "5.0.68",
    "@convex-dev/agent": "0.7.7",
    "@convex-dev/eslint-plugin": "5.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "26.6.5",
    "ai": "7.0.153",
    "convex": "1.47.0",
    "convex-helpers": "0.1.128",
    "convex-test": "0.0.61",
    "typescript": "5.9.3",
    "vite-plus": "1.2.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.34",
    "@ai-sdk/provider-utils": "^5.0.68",
    "@convex-dev/agent": "^0.7.7",
    "ai": "^7.0.153",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4"
  },
  "packageManager": "bun@1.4.3"
}

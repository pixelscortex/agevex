{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    // The tests are Vite sources: they use `import.meta.glob` and the fixture's
    // copied `_generated/api.js`, neither of which is valid under the root
    // library's NodeNext settings. The library's own sources stay strictly
    // NodeNext-checked through `bun run typecheck`.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    // The registry sources under docs/site/registry sit beside the docs site's
    // own node_modules, which carries a different `ai` patch version. Its
    // private-symbol types are not assignable to the root copy the Agent uses, so
    // resolve the registry's imports the way an installed host would: one copy.
    "paths": { "ai": ["../node_modules/ai"] },
    "allowJs": true
  },
  "include": ["./**/*.ts", "./**/*.js", "../src/**/*"]
}
